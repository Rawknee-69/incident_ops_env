# LLM Provider — set ONE of these two
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.0-flash

# Inference provider routing (inference.py)
# true  -> OpenRouter via OpenAI-compatible client
# false -> Gemini SDK
OPENROUTER_ENABLED=false

# OpenRouter/OpenAI-compatible settings
API_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=openai/gpt-4o-mini
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional OpenRouter attribution headers
OPENROUTER_HTTP_REFERER=
OPENROUTER_TITLE=

# Optional if running from docker image flow
LOCAL_IMAGE_NAME=

# Baseline script settings
# Set to 'scripted' to run without any API key (deterministic fallback policy)
# Set to 'openai' or 'gemini' to use a real LLM
BASELINE_PROVIDER=scripted
BASELINE_ENV_URL=http://localhost:7860

# Server settings
WORKERS=1
MAX_CONCURRENT_ENVS=100

# Gradio UI backend URL (used when running UI separately from server)
UI_BACKEND_URL=http://127.0.0.1:7860

# UI log verbosity: DEBUG, INFO, WARNING, ERROR
UI_LOG_LEVEL=INFO
